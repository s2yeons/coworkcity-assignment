PORT=4000
CLIENT_URL=http://localhost:3000
# 로컬: docker compose up -d (루트 docker-compose.yml)
DATABASE_URL=postgresql://coworkcity:coworkcity@localhost:5432/coworkcity
# (선택) 국세청 사업자등록정보 진위확인·상태조회 API 키 — 공공데이터포털(data.go.kr)에서 무료 발급
# https://www.data.go.kr/data/15081808/openapi.do  → 활용신청 후 "일반 인증키(Decoding)" 값
# 없으면 사업자등록번호 형식 검증만 수행하고 국세청 확인은 "미확인"으로 표시됩니다.
NTS_API_KEY=
# (선택) OCR 요청 속도 제한 (IP당 1분). 기본 300
OCR_RATE_LIMIT=300
